{
  "name": "gold-backend",
  "version": "0.1.0",
  "description": "Create clean Express and Prisma backends with Gold conventions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crisantus/gold-nodejs-backend.git"
  },
  "homepage": "https://github.com/crisantus/gold-nodejs-backend#readme",
  "bugs": {
    "url": "https://github.com/crisantus/gold-nodejs-backend/issues"
  },
  "bin": {
    "gold-backend": "dist/cli.js",
    "gold_backend": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "docs/USAGE.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-info.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "format": "prettier --write src tests scripts docs .github README.md package.json '*.json' '*.js' .vscode AGENTS.md && npm run format:templates",
    "format:check": "prettier --check src tests scripts docs .github README.md package.json '*.json' '*.js' .vscode AGENTS.md && npm run format:templates:check",
    "test": "vitest run",
    "test:generated": "tsx scripts/verify-generated.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "node scripts/prepare.mjs",
    "format:templates": "node --import tsx scripts/format-templates.ts",
    "format:templates:check": "node --import tsx scripts/format-templates.ts --check"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "commander": "^14.0.0",
    "zod": "^4.0.0",
    "prettier": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
